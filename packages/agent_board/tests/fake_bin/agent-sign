#!/usr/bin/env python3
#
# Stands in for the host's /usr/local/bin/agent-sign and follows the contract
# recorded in probes 2, 17, 19, 20 and 24, except that keys live under
# $FAKE_SIGN_KEY_DIR/<kind>/ rather than $HOME and there is no `verify`.

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

DEFAULT_CONFIG = "/etc/agent-identity.conf"
COMMANDS = ("sign", "pubkey", "whoami", "check")


class Refusal(Exception):
    pass


def load_config(path: str) -> dict:
    try:
        raw = json.loads(Path(path).read_text(encoding="utf-8"))
        kinds = {k["name"]: k["ai_agent"] for k in raw["kinds"]}
        return {"box": raw["box"], "namespace": raw["namespace"], "kinds": kinds}
    except (OSError, ValueError, KeyError, TypeError) as e:
        raise Refusal(f"cannot read config {path}: {e!r}") from e


def resolve_kind(config: dict, requested: str | None) -> str:
    kinds = config["kinds"]
    if requested is not None and requested not in kinds:
        raise Refusal(f"--as {requested}: not a configured kind ({', '.join(kinds)})")
    ai_agent = os.environ.get("AI_AGENT")
    if ai_agent is None:
        if requested is None:
            raise Refusal("AI_AGENT is unset and no --as KIND was given")
        return requested
    detected = next((name for name, value in kinds.items() if ai_agent.split("_", 1)[0] == value), None)
    if detected is None:
        raise Refusal(f"AI_AGENT={ai_agent} matches no configured kind, and --as "
                      "is accepted only when AI_AGENT is unset")
    if requested is not None and requested != detected:
        raise Refusal(f"--as {requested} refused: AI_AGENT={ai_agent} is kind {detected}")
    return detected


def principal(config: dict, kind: str) -> str:
    return f"{kind}@{config['box']}"


def key_path(kind: str) -> Path:
    return Path(os.environ["FAKE_SIGN_KEY_DIR"]) / kind / "id_ed25519"


def existing_key(config: dict, kind: str) -> Path:
    key = key_path(kind)
    if not key.is_file() or not Path(f"{key}.pub").is_file():
        raise Refusal(f"no identity for {principal(config, kind)} at {key}; run `agent-sign check`")
    return key


def cmd_sign(config: dict, args: argparse.Namespace) -> int:
    key = existing_key(config, resolve_kind(config, args.as_kind))
    message = sys.stdin.buffer if args.file == "-" else open(args.file, "rb")
    with message:
        result = subprocess.run(
            ["ssh-keygen", "-q", "-Y", "sign", "-f", str(key), "-n", config["namespace"]],
            stdin=message, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode != 0:
        sys.stderr.write(result.stderr.decode(errors="replace"))
        return 1
    sys.stdout.buffer.write(result.stdout)
    return 0


def cmd_pubkey(config: dict, args: argparse.Namespace) -> int:
    kinds = list(config["kinds"]) if args.all else [resolve_kind(config, args.as_kind)]
    lines = []
    for kind in kinds:
        keytype, blob = Path(f"{existing_key(config, kind)}.pub").read_text().split()[:2]
        lines.append(f'{principal(config, kind)} namespaces="{config["namespace"]}" {keytype} {blob}')
    print("\n".join(lines))
    return 0


def cmd_whoami(config: dict, args: argparse.Namespace) -> int:
    kind = resolve_kind(config, None)
    pub = f"{existing_key(config, kind)}.pub"
    result = subprocess.run(["ssh-keygen", "-l", "-f", pub], capture_output=True, text=True, check=True)
    print(principal(config, kind), result.stdout.split()[1])
    return 0


def cmd_check(config: dict, args: argparse.Namespace) -> int:
    states = {kind: "ok" if key_path(kind).is_file() else "missing" for kind in config["kinds"]}
    for kind, state in states.items():
        print(f"identity_{kind}={state}")
    return 0 if all(state == "ok" for state in states.values()) else 1


def parse(argv: list[str]) -> argparse.Namespace:
    top = argparse.ArgumentParser(prog="agent-sign", allow_abbrev=False)
    top.add_argument("--config", default=DEFAULT_CONFIG)
    sub = top.add_subparsers(dest="command", required=True)
    sign = sub.add_parser("sign")
    sign.add_argument("--as", dest="as_kind", metavar="KIND")
    sign.add_argument("file", nargs="?", default="-", metavar="FILE")
    pubkey = sub.add_parser("pubkey")
    which = pubkey.add_mutually_exclusive_group()
    which.add_argument("--as", dest="as_kind", metavar="KIND")
    which.add_argument("--all", action="store_true")
    sub.add_parser("whoami")
    sub.add_parser("check")
    rest = list(argv)
    i = 0
    while i < len(rest) and (rest[i] == "--config" or rest[i].startswith("--config=")):
        i += 2 if rest[i] == "--config" else 1
    if i >= len(rest) or rest[i] not in COMMANDS and rest[i] not in ("-h", "--help"):
        rest.insert(i, "sign")
    return top.parse_args(rest)


def main(argv: list[str]) -> int:
    args = parse(argv)
    try:
        config = load_config(args.config)
        return {"sign": cmd_sign, "pubkey": cmd_pubkey, "whoami": cmd_whoami,
                "check": cmd_check}[args.command](config, args)
    except Refusal as e:
        print(f"agent-sign: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
