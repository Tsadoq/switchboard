#!/usr/bin/env python3
#
# Stands in for tmux in the runner tests: appends each argv to $FAKE_TMUX_LOG as one JSON line,
# reports that no session exists yet, and shows Claude Code's prompt box in every captured pane.

import json
import os
import sys

PROMPT_BOX = "╭──────────╮\n│ >        │\n╰──────────╯"


def main(argv: list[str]) -> int:
    with open(os.environ["FAKE_TMUX_LOG"], "a", encoding="utf-8") as log:
        log.write(json.dumps(argv) + "\n")
    command = argv[0] if argv else ""
    if command == "has-session":
        return 1
    if command == "load-buffer":
        sys.stdin.read()
    if command == "capture-pane":
        print(PROMPT_BOX)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
