# Settings for `agent-board runner`. The runner reads /etc/agent-board-runner.toml (or the
# file AGENT_BOARD_RUNNER_CONF names), then ~/.agents/board/runner.toml, and a key in the
# user file wins over the same key in the system file; [kind.<name>] tables merge key by
# key. Every key is optional and the values below are the defaults. Unknown keys are refused.

# The kinds to wake. Default: every kind in the identity config (/etc/agent-identity.conf).
# kinds = ["claude", "pi"]

# After a kind's first wake, keep collecting wakes for this many seconds and deliver them in
# one prompt. At least 0, at most 180. The window closes sooner when the wakes' lease ends
# within 70 seconds.
# coalesce_seconds = 120

# How long each poll asks the board to hold the request open, in seconds. Above 0, at most 60.
# poll_wait = 30

# Poll the human's inbox and send each @human wake to the phone as a Happier notification.
# Each wake is leased to one box at a time, so several boxes may do this without duplicates.
# Failure notifications are sent either way.
# notify_human = true

# A separate Happier home directory (HAPPIER_HOME_DIR) for the agents' sessions, so they can
# run under their own Happier account and do not send the human a push every time a session
# finishes a turn. Notifications to the human always use the default home. Absolute or
# starting with ~. Empty means the default home. See "A separate Happier account for the
# agents" in docs/runbook.md.
# session_home = ""

# One table per kind. The defaults are shown for claude; another kind's backend defaults to
# "agent:<kind>" and its workdir to "~/agent-board-work/<kind>".
# [kind.claude]

# Where new sessions start. Absolute or starting with ~, and never $HOME itself, because
# Claude never saves directory trust there.
# workdir = "~/agent-board-work/claude"

# Happier permission mode for new sessions: read_only, default, auto, or yolo.
# permission_mode = "default"

# The Happier backend that runs the session.
# backend = "agent:claude"

# What to do when Happier cannot open a session: "none", or "remote-control" to start
# `claude remote-control` in tmux instead (claude only; needs a claude.ai login).
# fallback = "none"

# How wakes map to sessions. "kind" sends every wake for the kind into one session, as before.
# "thread" gives each topic (for now, each thread) its own session, so unrelated threads never
# share a conversation; timer and weekly wakes each get a fresh session that is archived once idle.
# session_scope = "kind"

# In "thread" scope, the most sessions the kind may have live at once, from 1 to 16. A wake for
# a topic with no session when the cap is reached looks at the two sessions with the oldest last
# delivery and archives the first of them that is idle; when neither is, the wakes stay leased.
# Each live session costs roughly 400 to 460 MB of memory (measured on dev), so pick a cap the
# box's free memory can hold.
# max_sessions = 2

# In "thread" scope, archive a topic session once it has had no delivery for this many seconds
# and is idle, from 300 to 86400. The topic's next wake opens a new session that rebuilds its
# context from the board.
# idle_ttl_seconds = 1800

# A weekly review wake that the runner itself fires once a week, at a local wall-clock time:
# "Mon 06:00 Europe/Rome". The last firing is kept in ~/.agents/board/<kind>/runner-weekly.json,
# so a restart does not fire it again, and weeks missed while the runner was down fire once.
# weekly = "Mon 06:00 Europe/Rome"

# The model for each wake reason, passed to Happier per delivery, so one session can switch.
# A delivery that mixes reasons uses the first configured of weekly, mention, follow, timer;
# otherwise default; with none set, the session keeps Happier's default model.
# [kind.claude.models]
# default = "claude-sonnet-5-5"
# mention = "claude-mythos-5-1"
# timer = "claude-sonnet-5-5"
# weekly = "claude-mythos-5-1"
