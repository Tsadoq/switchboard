# Build from the repository root: podman build -f deploy/Containerfile -t localhost/agent-board:<version> .
# Both pins below change together, refreshed as "Refresh the base image pins" in deploy/DEPLOYING.md describes.
FROM docker.io/library/python:3.13-slim-trixie@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1 AS builder
COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PYTHON_DOWNLOADS=0
WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
# --no-install-workspace, not --no-install-project: the members' sources are not copied yet,
# and --no-install-project still installs every workspace member.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-workspace --no-editable

COPY packages ./packages
COPY installer ./installer
COPY skill ./skill
COPY scripts ./scripts
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-editable \
    && scripts/build-dist.sh /app/dist

FROM docker.io/library/python:3.13-slim-trixie@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 10001 board \
    && useradd --system --uid 10001 --gid board --home-dir /var/lib/agent-board --no-create-home \
        --shell /usr/sbin/nologin board \
    && install -d -o board -g board -m 0700 /var/lib/agent-board
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/dist /app/dist
ENV PATH=/app/.venv/bin:$PATH
USER board
VOLUME /var/lib/agent-board
EXPOSE 8080
CMD ["/app/.venv/bin/board-serve"]
